# App
NODE_ENV=LOCAL
VERSION=1
PORT=3000
CORS_ORIGINS=
APP_DEV=true
AUTH_ENCRYPT_ENABLED=true

# Seguridad
CSRF_SECRET=
COOKIE_SECRET=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
IP_BLOCK_MAX_ATTEMPTS=5
IP_BLOCK_DURATION_MS=900000
IP_BLOCK_WINDOW_MS=600000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_service
DB_PASSWORD=
DB_NAME=financial_app
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=cost_manager_events

# Password hashing
BCRYPT_PEPPER=
BCRYPT_SALT_ROUNDS=12

# Encryption keys (64 hex chars = 32 bytes for AES-256)
ENC_IDENTITY_KEY=
ENC_FINANCE_KEY=
ENC_BANKING_KEY=

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SECRET=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Correo (react.email + Nodemailer)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Cost Manager <no-reply@example.com>"

# Secret para firmar los tokens de reset (POST /auth/verify-otp → /reset-password)
OTP_SECRET=
