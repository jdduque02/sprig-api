# Plantilla del entorno STAGE para docker-compose.stage.yml.
# Copia a .env.stage y reemplaza los valores en blanco / <genera-uno>.
# Genera secretos con: openssl rand -hex 32   (o node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# ---- App (backend) ----
NODE_ENV=STAGE
VERSION=1
PORT=3000
APP_DEV=false
AUTH_ENCRYPT_ENABLED=true
CORS_ORIGINS=http://localhost:8081

# ---- Seguridad ----
CSRF_SECRET=<genera-uno-hex-32-bytes>
COOKIE_SECRET=<genera-uno-hex-32-bytes>
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
IP_BLOCK_MAX_ATTEMPTS=5
IP_BLOCK_DURATION_MS=900000
IP_BLOCK_WINDOW_MS=600000
OTP_SECRET=<genera-uno-hex-32-bytes>
BCRYPT_PEPPER=<genera-uno-hex-16-bytes>
BCRYPT_SALT_ROUNDS=12

# ---- Encryption keys (64 hex chars = 32 bytes, AES-256) ----
ENC_IDENTITY_KEY=<genera-uno-hex-32-bytes>
ENC_FINANCE_KEY=<genera-uno-hex-32-bytes>
ENC_BANKING_KEY=<genera-uno-hex-32-bytes>

# ---- Database (Postgres en el propio compose) ----
DB_HOST=postgres
DB_PORT=5432
DB_USER=sprig_app
DB_PASSWORD=<password>
DB_NAME=cost_manager
DB_SSL=false

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<password>

# ---- RabbitMQ ----
RABBITMQ_USER=sprig
RABBITMQ_PASSWORD=<password>
RABBITMQ_URL=amqp://sprig:<password>@rabbitmq:5672
RABBITMQ_QUEUE=cost_manager_events

# ---- Keycloak ----
KEYCLOAK_URL=http://keycloak:8080
# Crea el realm/cliente manualmente en la consola de admin y actualiza estos 3:
KEYCLOAK_REALM=sprig-stage
KEYCLOAK_CLIENT_ID=sprig-api
KEYCLOAK_SECRET=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<password>

# ---- Correo (deshabilitado en stage por defecto) ----
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Sprig Stage <no-reply@example.com>"

# ---- Frontend (cost-manager-web) ----
VITE_API_URL=/api/v1

# ---- Puertos publicados en el host ----
FRONTEND_HTTP_PORT=8081
BACKEND_HTTP_PORT=3000
KEYCLOAK_HTTP_PORT=8080
RABBITMQ_MGMT_PORT=15672
