# =========================
# 1. Build stage
# =========================
FROM node:22-alpine AS builder

WORKDIR /app

RUN apk add --no-cache libc6-compat && corepack enable

# Copiar archivos de dependencias primero (cache de capas)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Instalar dependencias (incluye devDependencies, necesarias para build y migraciones)
RUN pnpm install --frozen-lockfile

# Copiar el resto del proyecto
COPY . .

# Compilar la app (nest build -> dist/src/main.js)
RUN pnpm run build

# =========================
# 2. Production stage
# =========================
FROM node:22-alpine AS deploy

WORKDIR /app

RUN corepack enable

# NODE_ENV se define vía docker-compose/.env según el entorno (STAGE, PROD, etc.)

# Crear usuario no root (seguridad)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copiar solo lo necesario desde builder
COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public

# Remover devDependencies
RUN pnpm prune --prod

RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 3000

CMD ["node", "dist/src/main.js"]
